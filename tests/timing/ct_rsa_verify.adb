--  Constant-time check for RSA signature verification (PSS and PKCS#1
--  v1.5). Verify's inputs are public, so this is about the SIGNATURE not
--  steering control flow: the modular exponentiation, the right-aligned
--  PSS window (leading-zero scan, trailer, H, salt, PS) and the PKCS#1
--  prefix compare must all be data-independent in the signature bytes.
--  The modulus and exponent stay defined: they are public and the
--  verifier deliberately branches on them (exponent >= 3 and odd, top-bit
--  dispatch, s < n). A 2049-bit modulus makes emLen = k - 1, so the
--  offset path is the one exercised.

with Ada.Command_Line;
with Ada.Text_IO; use Ada.Text_IO;
with Interfaces.C;
with SPARKNaCl; use SPARKNaCl;
with SPARKTLSCrypto.RSA;
with Ctgrind;

procedure Ct_RSA_Verify is
   N : constant Byte_Seq (0 .. 256) :=
     (16#01#, 16#3C#, 16#4D#, 16#87#, 16#23#, 16#94#, 16#57#, 16#FD#,
      16#D3#, 16#4A#, 16#2E#, 16#3F#, 16#1B#, 16#86#, 16#94#, 16#B6#,
