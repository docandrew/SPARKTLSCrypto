   OK_PSS, OK_PKCS1 : Boolean;
begin
   Ctgrind.Make_Undefined (Sig_PSS'Address, Interfaces.C.size_t (Sig_PSS'Length));
   Ctgrind.Make_Undefined (Sig_PKCS1'Address, Interfaces.C.size_t (Sig_PKCS1'Length));

   OK_PSS := SPARKTLSCrypto.RSA.Verify_PSS_SHA256
     (Hash => Hash, Modulus => N, Mod_Len => 257, Exponent => 65537,
      Signature => Sig_PSS, Sig_Len => 257);
   OK_PKCS1 := SPARKTLSCrypto.RSA.Verify_PKCS1_v1_5_SHA256
     (Hash => Hash, Modulus => N, Mod_Len => 257, Exponent => 65537,
      Signature => Sig_PKCS1, Sig_Len => 257);

   Ctgrind.Make_Defined (OK_PSS'Address, Interfaces.C.size_t (1));
   Ctgrind.Make_Defined (OK_PKCS1'Address, Interfaces.C.size_t (1));
   Ctgrind.Use_Output (OK_PSS'Address, Interfaces.C.size_t (1));
   Ctgrind.Use_Output (OK_PKCS1'Address, Interfaces.C.size_t (1));

   Put_Line ("ct_rsa_verify: PSS=" & OK_PSS'Image & " PKCS1=" & OK_PKCS1'Image);
   Ada.Command_Line.Set_Exit_Status (0);
end Ct_RSA_Verify;
