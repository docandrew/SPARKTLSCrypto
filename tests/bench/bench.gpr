with "../../sparktlscrypto.gpr";

project Bench is
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Source_Dirs use (".");
   for Main use ("crypto_bench.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-g", "-gnatp", "-gnat2022");
   end Compiler;
end Bench;
