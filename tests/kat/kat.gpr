with "../../sparktlscrypto.gpr";

project KAT is
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Source_Dirs use (".");
   for Main use ("kat_hmac_drbg.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-g", "-gnat2022", "-gnata", "-gnatwa");
   end Compiler;
end KAT;
