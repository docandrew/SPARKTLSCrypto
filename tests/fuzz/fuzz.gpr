with "../../sparktlscrypto.gpr";

project Fuzz is
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Source_Dirs use (".");
   for Main use ("diff_fuzz.adb");
   for Languages use ("Ada", "C");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O2", "-g", "-gnat2022", "-gnata");
      --  HACL_STAR_SRC: the pinned hacl-star checkout (flake input,
      --  exported by the dev shell) whose extracted C is the RSA-size
      --  Montgomery oracle.
      HACL := external ("HACL_STAR_SRC", "");
      for Default_Switches ("C") use
        ("-O2", "-g",
         "-I" & HACL & "/dist/gcc-compatible",
         "-I" & HACL & "/dist/karamel/include",
         "-I" & HACL & "/dist/karamel/krmllib/dist/minimal");
   end Compiler;
end Fuzz;
