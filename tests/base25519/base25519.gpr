with "../../sparktlscrypto.gpr";
project Base25519 is
   for Create_Missing_Dirs use "True";
   for Source_Dirs use (".");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Languages use ("Ada", "C");
   for Main use ("test_base25519.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O3", "-g", "-gnat2022", "-gnata");
      for Default_Switches ("C") use ("-O2", "-Wall", "-Wextra", "-Werror");
   end Compiler;
   --  The libcrypto to link and run against (the Nix shell exports the
   --  flake's; elsewhere the system one), as in tests/prepared.
   OpenSSL_Lib := External ("SPARKTLSCRYPTO_OPENSSL_LIB", "/usr/lib");
   package Linker is
      for Default_Switches ("Ada") use
        ("-L" & OpenSSL_Lib, "-Wl,-rpath," & OpenSSL_Lib, "-lcrypto");
   end Linker;
end Base25519;
