with "../../sparktlscrypto.gpr";
project Prepared is
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Source_Dirs use (".");
   for Languages use ("Ada", "C");
   for Main use ("test_prepared.adb", "bench_prepared.adb", "timing_prepared.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O3", "-g", "-gnat2022", "-gnata");
      for Default_Switches ("C") use ("-O2", "-g", "-Wall", "-Wextra", "-Werror");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-lcrypto");
   end Linker;
end Prepared;
