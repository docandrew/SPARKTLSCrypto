--  VAES + VPCLMULQDQ on 256-bit registers: an AES-GCM tier between the
--  4-block AES-NI kernels (SPARKTLSCrypto.AES_NI) and the AVX-512 ones
--  (SPARKTLSCrypto.AES_GCM_AVX512).
--
--  Many CPUs have the VEX-encoded VAES/VPCLMULQDQ but no AVX-512: AMD Zen 3
--  (which runs two 256-bit AES operations per cycle) and Intel's
--  Gracemont E-cores (Alder Lake, Alder Lake-N/Twin Lake: N100, N150...),
--  whose instruction tables list AESENC and PCLMULQDQ with VEX.256
--  throughput (Intel 350391-001, "Intel Processors based on Gracemont
--  Microarchitecture Instruction Throughput and Latency"). On these the
--  AES-NI tier keeps too few blocks in flight; sixteen blocks (eight ymm
--  registers) cover the AES latency on both.
--
--  Each kernel is generated by tools/generate_gcm_kernels.py (see there
--  for the algebra and acknowledgements); the GHASH arithmetic is that of
--  AES_GCM_AVX512.GHASH_16_Blocks, on two lanes instead of four, so the
--  results are bit-identical to the other tiers.
--
--  SPARK_Mode is Off in the body (inline assembly). Functional
--  equivalence with the proven SPARK code is checked by the tests in
--  tests/gcm16_fused, tests/prepared and tests/fuzz.

with SPARKNaCl;       use SPARKNaCl;
with SPARKTLSCrypto.AES_NI;

package SPARKTLSCrypto.AES_GCM_AVX2 with
   SPARK_Mode => On,
   Elaborate_Body
is
   --  True iff the CPU reports AVX2, VAES and VPCLMULQDQ
   --  (CPUID.(EAX=07H,ECX=0):EBX[5], ECX[9], ECX[10]) as well as AES-NI and
   --  PCLMULQDQ, the OS saves YMM state (OSXSAVE and XCR0 bits 1..2), and
   --  the build is not Portable_Only. Set once during elaboration.
   Has_VAES_AVX2 : Boolean := False with Constant_After_Elaboration;

   --  H^16 .. H^1, byte-reversed, descending (the layout of
   --  AES_GCM_AVX512.Pre_H_Powers_16).
   subtype Pre_H_Powers_16 is Byte_Seq (0 .. 255);

   --  Decrypt one 256-byte stripe in place: fold the ciphertext into S
   --  (one reduction per stripe) between the AES rounds of the counter
   --  blocks CB .. CB+15, then overwrite it with plaintext; CB advances by
   --  16 (inc32). No branch, index or address depends on Buf, S, the key
   --  or CB.
   procedure Decrypt_GCM_Stripe_16_128
     (Buf      : in out Byte_Seq;
      S        : in out Bytes_16;
      CB       : in out Bytes_16;
      Pre_RK   : in     AES_NI.Pre_Swapped_RKs_128;
      H_Powers : in     Pre_H_Powers_16)
   with Pre => Buf'Length = 256;

   procedure Decrypt_GCM_Stripe_16_256
     (Buf      : in out Byte_Seq;
      S        : in out Bytes_16;
      CB       : in out Bytes_16;
      Pre_RK   : in     AES_NI.Pre_Swapped_RKs_256;
      H_Powers : in     Pre_H_Powers_16)
   with Pre => Buf'Length = 256;

end SPARKTLSCrypto.AES_GCM_AVX2;
