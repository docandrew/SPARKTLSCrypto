   --  Round 2: x14
   --  mulx_u64(&x16, &x17, x14, 0xffffffff00000001)
   Mulx_U64 (x16, x17, x14, 16#FFFF_FFFF_0000_0001#);

   --  mulx_u64(&x18, &x19, x14, 0xffffffff)
