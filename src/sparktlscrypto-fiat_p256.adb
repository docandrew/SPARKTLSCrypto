   --  add: out1 := arg1 + arg2 mod p
   function Add (Arg1, Arg2 : FE) return FE is
      Out1 : FE;
      x1, x2, x3, x4, x5, x6, x7, x8   : Unsigned_64;
      x9, x10, x11, x12, x13, x14, x15, x16 : Unsigned_64;
      x17, x18, x19, x20, x21, x22      : Unsigned_64;
   begin
      --  4-limb addition with carry
      Addcarryx_U64 (x1, x2, 0, Arg1 (0), Arg2 (0));
      Addcarryx_U64 (x3, x4, x2, Arg1 (1), Arg2 (1));
      Addcarryx_U64 (x5, x6, x4, Arg1 (2), Arg2 (2));
      Addcarryx_U64 (x7, x8, x6, Arg1 (3), Arg2 (3));
      --  Tentatively subtract p
      Subborrowx_U64 (x9, x10, 0, x1, 16#FFFF_FFFF_FFFF_FFFF#);
      Subborrowx_U64 (x11, x12, x10, x3, 16#0000_0000_FFFF_FFFF#);
      Subborrowx_U64 (x13, x14, x12, x5, 0);
      Subborrowx_U64 (x15, x16, x14, x7, 16#FFFF_FFFF_0000_0001#);
      Subborrowx_U64 (x17, x18, x16, x8, 0);
      --  Conditional select: if borrow, keep sum; else keep subtracted
      declare Mask : constant Unsigned_64 := -(x18 and 1); begin
         x19 := (Mask and x1) or ((not Mask) and x9);
      end;
      declare Mask : constant Unsigned_64 := -(x18 and 1); begin
         x20 := (Mask and x3) or ((not Mask) and x11);
      end;
      declare Mask : constant Unsigned_64 := -(x18 and 1); begin
         x21 := (Mask and x5) or ((not Mask) and x13);
      end;
      declare Mask : constant Unsigned_64 := -(x18 and 1); begin
         x22 := (Mask and x7) or ((not Mask) and x15);
      end;
      Out1 := (x19, x20, x21, x22);
      return Out1;
   end Add;

   --  sub: out1 := arg1 - arg2 mod p
   function Sub (Arg1, Arg2 : FE) return FE is
      Out1 : FE;
      x1, x2, x3, x4, x5, x6, x7, x8 : Unsigned_64;
      x9, x10, x11, x12, x13, x14, x15, x16, x17 : Unsigned_64;
   begin
      --  4-limb subtraction with borrow
      Subborrowx_U64 (x1, x2, 0, Arg1 (0), Arg2 (0));
      Subborrowx_U64 (x3, x4, x2, Arg1 (1), Arg2 (1));
      Subborrowx_U64 (x5, x6, x4, Arg1 (2), Arg2 (2));
      Subborrowx_U64 (x7, x8, x6, Arg1 (3), Arg2 (3));
      --  If borrow, add p back (conditional on x8)
      declare Mask : constant Unsigned_64 := -(x8 and 1); begin
         x9 := Mask and 16#FFFF_FFFF_FFFF_FFFF#;  --  = 0 or p[0]
      end;
      Addcarryx_U64 (x10, x11, 0, x1, x9);
      Addcarryx_U64 (x12, x13, x11, x3, x9 and 16#0000_0000_FFFF_FFFF#);
      Addcarryx_U64 (x14, x15, x13, x5, 0);
      Addcarryx_U64 (x16, x17, x15, x7, x9 and 16#FFFF_FFFF_0000_0001#);
      Out1 := (x10, x12, x14, x16);
      return Out1;
   end Sub;

   --  opp: out1 := -arg1 mod p
   function Opp (Arg1 : FE) return FE is
      Out1 : FE;
      x1, x2, x3, x4, x5, x6, x7, x8 : Unsigned_64;
      x9, x10, x11, x12, x13, x14, x15, x16, x17 : Unsigned_64;
   begin
      --  Subtract arg1 from 0 with borrow chain
      Subborrowx_U64 (x1, x2, 0, 0, Arg1 (0));
      Subborrowx_U64 (x3, x4, x2, 0, Arg1 (1));
      Subborrowx_U64 (x5, x6, x4, 0, Arg1 (2));
      Subborrowx_U64 (x7, x8, x6, 0, Arg1 (3));
      --  Conditionally add p
      declare Mask : constant Unsigned_64 := -(x8 and 1); begin
         x9 := Mask and 16#FFFF_FFFF_FFFF_FFFF#;
      end;
      Addcarryx_U64 (x10, x11, 0, x1, x9);
      Addcarryx_U64 (x12, x13, x11, x3, x9 and 16#0000_0000_FFFF_FFFF#);
      Addcarryx_U64 (x14, x15, x13, x5, 0);
      Addcarryx_U64 (x16, x17, x15, x7, x9 and 16#FFFF_FFFF_0000_0001#);
      Out1 := (x10, x12, x14, x16);
      return Out1;
   end Opp;

   --  selectznz: constant-time conditional select
   function Selectznz (Cond : Unsigned_64;
                        Arg2, Arg3 : FE) return FE is
      Out1 : FE;
      Mask : constant Unsigned_64 := -(Cond and 1);
   begin
      --  if Cond = 0, select Arg2; else select Arg3
      Out1 := ((Mask and Arg3 (0)) or ((not Mask) and Arg2 (0)),
               (Mask and Arg3 (1)) or ((not Mask) and Arg2 (1)),
               (Mask and Arg3 (2)) or ((not Mask) and Arg2 (2)),
               (Mask and Arg3 (3)) or ((not Mask) and Arg2 (3)));
      return Out1;
   end Selectznz;

   --  nonzero
   procedure Nonzero (Out1 : out Unsigned_64; Arg1 : FE) is
   begin
      Out1 := Arg1 (0) or Arg1 (1) or Arg1 (2) or Arg1 (3);
   end Nonzero;

   --  to_bytes: field element to 32 little-endian bytes
   procedure To_Bytes (Out1 : out Byte_Seq; Arg1 : FE) is
      F : constant I32 := Out1'First;
   begin
      Out1 := (others => 0);
      for Limb_Idx in 0 .. 3 loop
         declare
            V : Unsigned_64 := Arg1 (Limb_Idx);
            Base : constant I32 := F + I32 (Limb_Idx) * 8;
         begin
            for B in 0 .. 7 loop
               Out1 (Base + I32 (B)) := Byte (V and 16#FF#);
               V := Shift_Right (V, 8);
            end loop;
         end;
      end loop;
   end To_Bytes;

   --  from_bytes: 32 little-endian bytes to field element
   function From_Bytes (Arg1 : Byte_Seq) return FE is
      Out1 : FE;
      F : constant I32 := Arg1'First;
   begin
      for Limb_Idx in 0 .. 3 loop
         declare
            V : Unsigned_64 := 0;
            Base : constant I32 := F + I32 (Limb_Idx) * 8;
         begin
            for B in reverse 0 .. 7 loop
               V := Shift_Left (V, 8) or Unsigned_64 (Arg1 (Base + I32 (B)));
            end loop;
            Out1 (Limb_Idx) := V;
         end;
      end loop;
      return Out1;
   end From_Bytes;

   --  from_montgomery / to_montgomery
