   Addcarryx_U64 (x99, x100, 0, x75, x90);
   Addcarryx_U64 (x101, x102, x100, x77, x92);
   Addcarryx_U64 (x103, x104, x102, x79, x94);
   Addcarryx_U64 (x105, x106, x104, x81, x96);
   Addcarryx_U64 (x107, x108, x106, x83, x98);

   -- Montgomery reduction 3
   Mulx_U64 (x109, x110, x99, 16#FFFF_FFFF_0000_0001#);
   Mulx_U64 (x111, x112, x99, 16#0000_0000_FFFF_FFFF#);
   Mulx_U64 (x113, x114, x99, 16#FFFF_FFFF_FFFF_FFFF#);

   Addcarryx_U64 (x115, x116, 0, x114, x111);
   x117 := x116 + x112;

   Addcarryx_U64 (x118, x119, 0, x99, x113);
   Addcarryx_U64 (x120, x121, x119, x101, x115);
   Addcarryx_U64 (x122, x123, x121, x103, x117);
