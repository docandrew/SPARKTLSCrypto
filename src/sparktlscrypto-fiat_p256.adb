   Mulx_U64 (x20, x21, x11, 16#FFFF_FFFF_0000_0001#);
   Mulx_U64 (x22, x23, x11, 16#0000_0000_FFFF_FFFF#);
   Mulx_U64 (x24, x25, x11, 16#FFFF_FFFF_FFFF_FFFF#);

   Addcarryx_U64 (x26, x27, 0, x25, x22);
   x28 := x27 + x23;

   Addcarryx_U64 (x29, x30, 0, x11, x24);
   Addcarryx_U64 (x31, x32, x30, x13, x26);
   Addcarryx_U64 (x33, x34, x32, x15, x28);
   Addcarryx_U64 (x35, x36, x34, x17, x20);
