   Addcarryx_U64 (x126, x127, x125, x107, x110);
   x128 := x127 + x108;

   -- Round 4: multiply by x3 = arg1[3]
   Mulx_U64 (x129, x130, x3, Arg1 (3));
   Mulx_U64 (x131, x132, x3, Arg1 (2));
   Mulx_U64 (x133, x134, x3, Arg1 (1));
   Mulx_U64 (x135, x136, x3, Arg1 (0));

   Addcarryx_U64 (x137, x138, 0, x136, x133);
   Addcarryx_U64 (x139, x140, x138, x134, x131);
   Addcarryx_U64 (x141, x142, x140, x132, x129);
   x143 := x142 + x130;

   Addcarryx_U64 (x144, x145, 0, x120, x135);
   Addcarryx_U64 (x146, x147, x145, x122, x137);
   Addcarryx_U64 (x148, x149, x147, x124, x139);
   Addcarryx_U64 (x150, x151, x149, x126, x141);
   Addcarryx_U64 (x152, x153, x151, x128, x143);

   -- Montgomery reduction 4
   Mulx_U64 (x154, x155, x144, 16#FFFF_FFFF_0000_0001#);
   Mulx_U64 (x156, x157, x144, 16#0000_0000_FFFF_FFFF#);
   Mulx_U64 (x158, x159, x144, 16#FFFF_FFFF_FFFF_FFFF#);

   Addcarryx_U64 (x160, x161, 0, x159, x156);
   x162 := x161 + x157;

   Addcarryx_U64 (x163, x164, 0, x144, x158);
