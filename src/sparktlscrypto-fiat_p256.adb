   -- Final conditional subtraction of p
   Subborrowx_U64 (x174, x175, 0, x165, 16#FFFF_FFFF_FFFF_FFFF#);
   Subborrowx_U64 (x176, x177, x175, x167, 16#0000_0000_FFFF_FFFF#);
