   Mulx_U64 (x62, x63, x54, 16#FFFF_FFFF#);

   --  mulx_u64(&x64, &x65, x54, 0xffffffffffffffff)
   Mulx_U64 (x64, x65, x54, 16#FFFF_FFFF_FFFF_FFFF#);

   --  addcarryx_u64(&x66, &x67, 0x0, x65, x62)
   Addcarryx_U64 (x66, x67, 0, x65, x62);

