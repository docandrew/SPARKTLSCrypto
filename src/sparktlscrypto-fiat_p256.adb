begin
   -- Load arg1 limbs
   x1 := Arg1 (1);
   x2 := Arg1 (2);
   x3 := Arg1 (3);
   x4 := Arg1 (0);

   -- Round 1: multiply by x4 = arg1[0]
   Mulx_U64 (x5, x6, x4, Arg1 (3));
   Mulx_U64 (x7, x8, x4, Arg1 (2));
   Mulx_U64 (x9, x10, x4, Arg1 (1));
