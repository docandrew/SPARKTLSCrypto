   procedure Addcarryx_U64
     (Out1 : out Unsigned_64;
      Out2 : out Unsigned_64;
      Arg1 :     Unsigned_64;
      Arg2 :     Unsigned_64;
      Arg3 :     Unsigned_64)
   with Inline
   is
