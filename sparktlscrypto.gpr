with "config/sparktlscrypto_config.gpr";
project SPARKTLSCrypto is

   for Library_Name use "sparktlscrypto";
   for Library_Version use Project'Library_Name & ".so." & SPARKTLSCrypto_Config.Crate_Version;

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SPARKTLSCRYPTO_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   type Enabled_Kind is ("enabled", "disabled");
   Compile_Checks   : Enabled_Kind := External ("SPARKTLSCRYPTO_COMPILE_CHECKS", "disabled");
   Runtime_Checks   : Enabled_Kind := External ("SPARKTLSCRYPTO_RUNTIME_CHECKS", "disabled");
   Style_Checks     : Enabled_Kind := External ("SPARKTLSCRYPTO_STYLE_CHECKS", "disabled");
   Contracts_Checks : Enabled_Kind := External ("SPARKTLSCRYPTO_CONTRACTS", "disabled");

   type Build_Kind is ("debug", "optimize", "ctgrind");
   Build_Mode : Build_Kind := External ("SPARKTLSCRYPTO_BUILD_MODE", "optimize");

   Compile_Checks_Switches := ();
   case Compile_Checks is
      when "enabled" =>
         Compile_Checks_Switches :=
           ("-gnatwa",  -- All warnings
            "-gnatVa",  -- All validity checks
            "-gnatwe"); -- Warnings as errors
      when others => null;
   end case;

   Runtime_Checks_Switches := ();
   case Runtime_Checks is
      when "enabled" => null;
      when others =>
         Runtime_Checks_Switches := ("-gnatp"); -- Suppress checks
   end case;

   Style_Checks_Switches := ();
   case Style_Checks is
      when "enabled" =>
         Style_Checks_Switches :=
           ("-gnatyg",
            "-gnaty-d",
            "-gnatyM120",
            "-gnatyO");
      when others => null;
   end case;

   Contracts_Switches := ();
   case Contracts_Checks is
      when "enabled" =>
         Contracts_Switches := ("-gnata");
      when others => null;
   end case;

   Build_Switches := ();
   case Build_Mode is
      when "optimize" =>
         Build_Switches := ("-O3",
                            "-gnatn",
                            "-march=native",
                            "-mtune=native");
      when "debug" =>
         Build_Switches := ("-g", "-Og");
      when "ctgrind" =>
         --  Constant-time analysis under Valgrind. Keep AVX-512
         --  enabled at the assembler level so the explicit inline
         --  asm in the AVX-512 modules still compiles, but disable
         --  GCC's auto-vectorization (-fno-tree-vectorize) so scalar
         --  Ada code doesn't end up emitting zmm-store instructions
         --  that Valgrind 3.22 doesn't decode. Under Valgrind the
         --  CPUID detection lies about AVX-512 anyway, so the
         --  AVX-512 dispatches fall back to the scalar paths — and
         --  the scalar paths are exactly what we want to vet.
         Build_Switches :=
           ("-O2", "-g",
            "-march=x86-64-v3",
            "-mavx512f", "-mavx512dq", "-mavx512bw",
            "-mavx512vl", "-mavx512ifma", "-mvaes", "-mvpclmulqdq",
            "-fno-tree-vectorize");
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        Compile_Checks_Switches &
        Build_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X",
         "-gnat2022",
         "-gnatQ");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end SPARKTLSCrypto;
