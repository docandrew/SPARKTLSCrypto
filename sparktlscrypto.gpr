with "config/sparktlscrypto_config.gpr";
project SPARKTLSCrypto is

   for Library_Name use "sparktlscrypto";
   for Library_Version use Project'Library_Name & ".so." & SPARKTLSCrypto_Config.Crate_Version;

   --  Accelerated tiers: dispatch on CPUID (enabled, default), never
   --  (disabled: proven SPARK code only), or assume the BMI2/ADX tier is
   --  present without CPUID (assume_bmi2_adx: constant-time test lanes
   --  under Valgrind only). Compiled in via SPARKTLSCrypto.Tier_Config.
   type Asm_Kind is ("enabled", "disabled", "assume_bmi2_adx");
   Asm_Mode : Asm_Kind := External ("SPARKTLSCRYPTO_ASM", "enabled");

   for Source_Dirs use ("src", "src/tiers/" & Asm_Mode);
   --  The tier variants share basenames (Tier_Config), so each Asm_Mode
   --  gets its own object and library directory; the default keeps the
   --  paths the proof and CI scripts expect.
   Asm_Dir_Suffix := "";
   case Asm_Mode is
      when "enabled" => Asm_Dir_Suffix := "";
      when others    => Asm_Dir_Suffix := "/" & Asm_Mode;
   end case;
   for Object_Dir use "obj" & Asm_Dir_Suffix;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib" & Asm_Dir_Suffix;

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SPARKTLSCRYPTO_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   type Enabled_Kind is ("enabled", "disabled");
   Compile_Checks   : Enabled_Kind := External ("SPARKTLSCRYPTO_COMPILE_CHECKS", "disabled");
   Runtime_Checks   : Enabled_Kind := External ("SPARKTLSCRYPTO_RUNTIME_CHECKS", "disabled");
   Style_Checks     : Enabled_Kind := External ("SPARKTLSCRYPTO_STYLE_CHECKS", "disabled");
   Contracts_Checks : Enabled_Kind := External ("SPARKTLSCRYPTO_CONTRACTS", "disabled");

   type Build_Kind is ("debug", "optimize", "native", "ctgrind");
   Build_Mode : Build_Kind := External ("SPARKTLSCRYPTO_BUILD_MODE", "optimize");

   Compile_Checks_Switches := ();
   case Compile_Checks is
      when "enabled" =>
         Compile_Checks_Switches :=
           ("-gnatwa",  -- All warnings
            "-gnatVa",  -- All validity checks
            "-gnatwe"); -- Warnings as errors
      when others => null;
   end case;

   Runtime_Checks_Switches := ();
   case Runtime_Checks is
      when "enabled" => null;
      when others =>
         Runtime_Checks_Switches := ("-gnatp"); -- Suppress checks
   end case;

   Style_Checks_Switches := ();
   case Style_Checks is
      when "enabled" =>
         Style_Checks_Switches :=
           ("-gnatyg",
            "-gnaty-d",
            "-gnatyM120",
            "-gnatyO");
      when others => null;
   end case;

   Contracts_Switches := ();
   case Contracts_Checks is
      when "enabled" =>
         Contracts_Switches := ("-gnata");
      when others => null;
   end case;

   --  -fno-tree-vrp: GCC's value-range propagation miscompiles code of this
   --  kind in GNAT 15.2 and 16.1 (the GCC 14 change SPARKNaCl works around the
   --  same way). Measured 2026-09-24 on SPARKNaCl's SHA-256: at -O2 and -O3
   --  every digest was wrong; with this flag, or at -O1, or with GNAT 13.2,
   --  all were right. Optimised modes only: -Og does not run the pass.
   Build_Switches := ();
   AES_NI_Switches := ("-maes", "-mpclmul", "-mssse3");
   ADX_Switches    := ("-mbmi2", "-madx");
   AVX2_Switches   := ("-mavx2");
   AVX512_Switches := ("-mavx512f", "-mavx512dq", "-mavx512bw",
                       "-mavx512vl", "-mavx512ifma", "-mvaes",
                       "-mvpclmulqdq");
   case Build_Mode is
      when "optimize" =>
         Build_Switches := ("-O3",
                            "-gnatn",
                            "-fno-tree-vrp",
                            "-march=x86-64-v2",
                            "-fno-tree-vectorize");
      when "native" =>
         Build_Switches := ("-O3",
                            "-gnatn",
                            "-fno-tree-vrp",
                            "-march=native",
                            "-mtune=native");
      when "debug" =>
         Build_Switches := ("-g", "-Og");
      when "ctgrind" =>
         --  Constant-time analysis under Valgrind. Keep the default
         --  scalar units on a Valgrind-friendly baseline and disable
         --  GCC's auto-vectorization. The explicit AVX-512 modules
         --  still get AVX512_Switches through their per-file switches
         --  below so their inline asm can assemble, but ordinary
         --  scalar units must not emit EVEX/zmm instructions before
         --  runtime CPUID dispatch runs.
         Build_Switches :=
           ("-O2", "-g",
            "-fno-tree-vrp",
            "-march=x86-64-v2",
            "-fno-tree-vectorize");
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        Compile_Checks_Switches &
        Build_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X",
         "-gnat2022",
         "-gnatQ");

      --  Keep optimized/default builds on the portable x86-64-v2
      --  baseline. The accelerated units still need instruction
      --  feature switches so their inline asm assembles, but those
      --  switches must not give GCC permission to emit AVX-512 in
      --  ordinary scalar units before runtime CPUID dispatch runs.
      for Switches ("sparktlscrypto-aes_ni.adb") use
        Compile_Checks_Switches &
        Build_Switches &
        AES_NI_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X", "-gnat2022", "-gnatQ");

      for Switches ("sparktlscrypto-bignat64_adx.adb") use
        Compile_Checks_Switches &
        Build_Switches &
        ADX_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X", "-gnat2022", "-gnatQ");

      for Switches ("sparktlscrypto-p256_gather_avx2.adb") use
        Compile_Checks_Switches &
        Build_Switches &
        AVX2_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X", "-gnat2022", "-gnatQ");

      for Switches ("sparktlscrypto-ghash_ni.adb") use
        Compile_Checks_Switches &
        Build_Switches &
        AES_NI_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X", "-gnat2022", "-gnatQ");

      for Switches ("sparktlscrypto-aes_gcm_avx512.adb") use
        Compile_Checks_Switches &
        Build_Switches &
        AVX512_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X", "-gnat2022", "-gnatQ");

      for Switches ("sparktlscrypto-chacha20_avx512.adb") use
        Compile_Checks_Switches &
        Build_Switches &
        AVX512_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X", "-gnat2022", "-gnatQ");

      for Switches ("sparktlscrypto-poly1305_avx512.adb") use
        Compile_Checks_Switches &
        Build_Switches &
        AVX512_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X", "-gnat2022", "-gnatQ");

      for Switches ("sparktlscrypto-poly1305_avx512_ifma.adb") use
        Compile_Checks_Switches &
        Build_Switches &
        AVX512_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X", "-gnat2022", "-gnatQ");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

end SPARKTLSCrypto;
